<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWpf>true</UseWpf>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <Version>1.15.9</Version>
    <AssemblyVersion>1.15.9.0</AssemblyVersion>
    <FileVersion>1.15.9.0</FileVersion>
    <InformationalVersion>1.15.9</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AssemblyName>AcadBatchPlot</AssemblyName>
    <RootNamespace>ZwcadBatchPlot</RootNamespace>
    <DefineConstants>$(DefineConstants);AUTOCAD</DefineConstants>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>$(RepoRoot)bin-acad\</OutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <DocnetRuntime>win-x64</DocnetRuntime>
  </PropertyGroup>

  <!-- 公共源码含平台条件编译（#if ZWCAD / #if AUTOCAD / #if ACAD_CORE），必须与平台实现
       一起按各自的编译常量编译并内联进单个 DLL，以便 CAD 通过 NETLOAD 加载单个文件。 -->
  <ItemGroup>
    <Compile Include="..\Common\**\*.cs" />
    <Compile Include="..\AutoCAD\**\*.cs" />
    <Page Include="..\Common\**\*.xaml">
      <Link>Common\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <EmbeddedResource Include="..\AutoCAD\**\*.resx" />

    <ProjectReference Include="..\PianNoCN\PianNoCN.csproj" />
    <None Remove="..\Common\**\*" />
    <None Remove="..\AutoCAD\**\*" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(RepoRoot)resources\acad\Plotters\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Plotters\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="PDFsharp" Version="1.50.5147" />
    <PackageReference Include="SharpZipLib" Version="1.3.3" />
    <PackageReference Include="System.Resources.Extensions" Version="7.0.0" />
    <PackageReference Include="Docnet.Core" Version="2.6.0" />
  </ItemGroup>

  <!-- AutoCAD 托管引用：必须引用「最低支持版本」= AutoCAD 2015（R20.0），运行时由宿主提供。
       跨版本兼容铁律：用最低版本 SDK 编译的插件可在 2015~2024 上 NETLOAD；
       反过来引用高版本（如 2024 / R24.3）编译，低版本主机会因托管程序集版本不匹配而加载失败。
       ExcludeAssets="runtime" 保证 acmgd/acdbmgd/accoremgd 不被复制到插件目录，始终使用宿主自带的。 -->
  <ItemGroup>
    <PackageReference Include="AutoCAD.NET" Version="20.0.1">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- CAD NETLOAD 只从插件目录加载原生库；确保 pdfium.dll 与主 DLL 同级。 -->
  <Target Name="CopyPdfiumForCadHost" AfterTargets="Build">
    <PropertyGroup>
      <_PdfiumSrc>$(NuGetPackageRoot)docnet.core\2.6.0\runtimes\win-x64\native\pdfium.dll</_PdfiumSrc>
    </PropertyGroup>
    <Copy SourceFiles="$(_PdfiumSrc)" DestinationFiles="$(OutputPath)pdfium.dll" SkipUnchangedFiles="true" Condition="Exists('$(_PdfiumSrc)')" />
  </Target>
</Project>
