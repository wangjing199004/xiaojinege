<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ZwcadBatchPlot.SinglePlotPaperSelectionForm"
        Title="选择纸张"
        Width="520" MinWidth="500" MinHeight="190"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI"
        FontSize="11"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        Background="{x:Static SystemColors.ControlBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="WpfUi.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- 单项选择对话框采用三行紧凑布局，保留下拉选项完整显示宽度。 -->
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" VerticalAlignment="Center" Margin="0,0,0,8"
                   TextWrapping="Wrap"
                   Text="该外框可匹配多种纸张和比例，&#x0a;请选择本次打印使用的纸张：" />

        <ComboBox x:Name="_choices" Grid.Row="1" IsEditable="False" MinHeight="22"
                  VerticalContentAlignment="Center" />

        <!-- WinForms FlowDirection=RightToLeft，先加的在最右。 -->
        <DockPanel Grid.Row="2" LastChildFill="False" Margin="0,12,0,0">
            <Button Content="确定" MinWidth="82" DockPanel.Dock="Right"
                    IsDefault="True" Style="{StaticResource PluginButtonStyle}" Click="Ok_Click" />
            <Button Content="取消" MinWidth="82" DockPanel.Dock="Right"
                    IsCancel="True" Style="{StaticResource PluginButtonStyle}" />
        </DockPanel>
    </Grid>
</Window>
