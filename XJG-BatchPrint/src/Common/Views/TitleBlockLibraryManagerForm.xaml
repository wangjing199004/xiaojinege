<UserControl x:Class="ZwcadBatchPlot.TitleBlockLibraryControl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ZwcadBatchPlot"
        FontFamily="Microsoft YaHei UI"
        FontSize="11"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        Background="{x:Static SystemColors.ControlBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="WpfUi.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel>
        <!-- 顶部按钮行（对应原 FlowLayoutPanel，不换行，可横向滚动） -->
        <ScrollViewer DockPanel.Dock="Top"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal" Margin="8,5,8,4">
                <Button Content="新增图框" Margin="0,0,4,0"
                        Style="{StaticResource PluginButtonStyle}" Click="OnAddTitleBlockClick" />
                <Button x:Name="_saveButton" Content="保存修改" Margin="0,0,4,0"
                        Style="{StaticResource PluginButtonStyle}" Click="OnSaveClick" />
                <Button Content="删除选中" Margin="0,0,4,0"
                        Style="{StaticResource PluginButtonStyle}" Click="OnDeleteClick" />
                <Button Content="重新读取" Margin="0,0,4,0"
                        Style="{StaticResource PluginButtonStyle}" Click="OnReloadClick"
                        ToolTip="从配置文件重新加载已保存的图框库，刷新列表和当前图纸匹配状态；修改图框字段请双击该行或右键编辑。" />
                <Button Content="识别图框模式" Margin="0,0,4,0"
                        Style="{StaticResource PluginButtonStyle}" Click="OnRecognizeModesClick"
                        ToolTip="按纸张 1:1 后，图名、图号角点相对图纸右下角的位置归类。同一套图框的 A2、A3 若右下角关系一致，会归为同一模式。" />
                <Button Content="导入图框库" Margin="0,0,4,0"
                        Style="{StaticResource PluginButtonStyle}" Click="OnImportClick" />
                <Button Content="导出图框库" Margin="0,0,4,0"
                        Style="{StaticResource PluginButtonStyle}" Click="OnExportClick" />
                <Button Content="打开配置目录" Margin="0,0,4,0"
                        Style="{StaticResource PluginButtonStyle}" Click="OnOpenFolderClick" />
                <Button Content="关闭" Margin="0,0,0,0"
                        Style="{StaticResource PluginButtonStyle}" Click="OnCloseClick" />
            </StackPanel>
        </ScrollViewer>

        <!-- 底部状态栏 -->
        <Border DockPanel.Dock="Bottom">
            <TextBlock x:Name="_status" VerticalAlignment="Center" Margin="8,0,0,0"
                       TextTrimming="CharacterEllipsis" />
        </Border>

        <!-- 行数据表格（列在 code-behind 中按原 DataGridView 列定义构建） -->
        <DataGrid x:Name="_grid"
                  Style="{StaticResource PluginGridStyle}"
                  Margin="0"
                  IsReadOnly="True"
                  Sorting="GridSorting"
                  LoadingRow="GridLoadingRow"
                  MouseDoubleClick="GridMouseDoubleClick"
                  ContextMenuOpening="GridContextMenuOpening"
                  PreviewMouseRightButtonDown="GridPreviewMouseRightButtonDown">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <!-- 当前 CAD 中已存在的图框整行淡粉色，方便用户快速认出新录入条目 -->
                        <DataTrigger Binding="{Binding PresentInDrawing}" Value="True">
                            <Setter Property="Background" Value="#FFE6E6" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.ContextMenu>
                <ContextMenu x:Name="_rowMenu">
                    <MenuItem Header="编辑" Click="OnEditMenuItemClick" />
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>
    </DockPanel>
</UserControl>
