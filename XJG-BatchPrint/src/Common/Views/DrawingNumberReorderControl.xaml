<UserControl x:Class="ZwcadBatchPlot.DrawingNumberReorderControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI" FontSize="11">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="WpfUi.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="12,10,12,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="28"/>
            <RowDefinition Height="28"/>
            <RowDefinition Height="48"/>
            <RowDefinition Height="28"/>
            <RowDefinition Height="48"/>
            <RowDefinition Height="28"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="72"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 前缀 -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="前缀" VerticalAlignment="Center"/>
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="PrefixBox" Text=""
                 Width="160" MinHeight="22" HorizontalAlignment="Left"
                 VerticalContentAlignment="Center"
                 TextChanged="OnTextChanged"/>

        <!-- 后缀 -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="后缀" VerticalAlignment="Center"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="SuffixBox" Text=""
                 Width="160" MinHeight="22" HorizontalAlignment="Left"
                 VerticalContentAlignment="Center"
                 TextChanged="OnTextChanged"/>

        <!-- 起始图号 -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="起始图号" VerticalAlignment="Center"/>
        <Border Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center"
                BorderBrush="#FFABADB3" BorderThickness="1" Background="White"
                Width="100" MinHeight="22">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="StartNumberBox" Text="1"
                         Grid.Column="0" BorderThickness="0"
                         VerticalContentAlignment="Center"
                         PreviewTextInput="OnStartNumberPreviewTextInput"
                         TextChanged="OnTextChanged"/>
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <RepeatButton Grid.Row="0" Content="▲" FontSize="6"
                                  BorderThickness="0" Background="#FFF0F0F0"
                                  Click="OnStartNumberUp"/>
                    <RepeatButton Grid.Row="1" Content="▼" FontSize="6"
                                  BorderThickness="0" Background="#FFF0F0F0"
                                  Click="OnStartNumberDown"/>
                </Grid>
            </Grid>
        </Border>

        <!-- 位数 -->
        <TextBlock Grid.Row="3" Grid.Column="0" Text="位数" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="3" Grid.Column="1" x:Name="DigitsCombo"
                  Width="100" MinHeight="22" HorizontalAlignment="Left"
                  VerticalContentAlignment="Center"
                  SelectionChanged="OnDigitsChanged"/>

        <!-- 图号重排本质上按空间位置生成新图号，因此方向必须在本窗口中直接可见、可选。 -->
        <TextBlock Grid.Row="4" Grid.Column="0" Text="空间顺序" VerticalAlignment="Top" Margin="0,4,0,0"/>
        <StackPanel Grid.Row="4" Grid.Column="1" VerticalAlignment="Center">
            <RadioButton x:Name="TopToBottomRadio" GroupName="RenumberSpatialOrder" IsChecked="True"
                         Content="从上到下、从左到右" Margin="0,0,0,4"/>
            <RadioButton x:Name="LeftToRightRadio" GroupName="RenumberSpatialOrder"
                         Content="从左到右、从上到下"/>
        </StackPanel>

        <!-- 预览 -->
        <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" x:Name="PreviewLabel"
                   VerticalAlignment="Center"
                   Foreground="DimGray"/>

        <!-- 按钮 -->
        <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
                    HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="确定" MinWidth="76" Style="{StaticResource PluginButtonStyle}"
                    Click="OnOkClick" Margin="0,0,4,0"/>
            <Button Content="预览顺序" MinWidth="88" Style="{StaticResource PluginButtonStyle}"
                    Click="OnPreviewClick" Margin="0,0,4,0"/>
            <Button Content="取消" MinWidth="76" Style="{StaticResource PluginButtonStyle}"
                    Click="OnCancelClick"/>
        </StackPanel>
    </Grid>
</UserControl>
